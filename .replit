modules = ["nodejs-20", "web", "python-base-3.13", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 23636
externalPort = 3001

[userenv]

[userenv.development]
GS1_ENVIRONMENT = "acceptance"
PASSWORD_RESET_BASE_URL = "https://391cc0ff-9efa-4cc1-8e90-441cc67158d1-00-2lda5e2kz1axc.janeway.replit.dev"

[userenv.production]
PASSWORD_RESET_BASE_URL = "https://dpp.gwcirculair.nl"

[userenv.shared]
PASSWORD_RESET_FROM = "support@gwcirculair.nl"
